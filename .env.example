# Copy to .env and fill in. .env is gitignored and never committed.

# Postgres. Matches docker-compose.yml out of the box.
DATABASE_URL=postgres://api_guardian:api_guardian@localhost:5432/api_guardian

# GitHub personal access token, used by the PR writer in week 8.
# Scope: `repo` on the repositories API Guardian maintains.
# v1 uses a PAT; the GitHub App comes later (build plan, section 5).
GITHUB_TOKEN=

# Model credentials for the repair agent (weeks 6-7). Section 9 runs the
# evaluation over at least two models, so both live here.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
